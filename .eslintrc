{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "2021",
    "ecmaFeatures": {
        "jsx": true
    },
    "sourceType": "module"
  },
  "rules": {
    "linebreak-style": "off",
    "prettier/prettier": ["error", { "singleQuote": true, "semi": true, "endOfLine": "auto" }],
    "no-console": "warn",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-require-imports": "off",
    "@typescript-eslint/no-unused-expressions": "warn",
    "@typescript-eslint/ban-ts-comment": "off",
    "prefer-const": "warn",
    "no-restricted-syntax": [
      "error",
      {
        "selector": ":matches(CallExpression, OptionalCallExpression)[callee.property.name='toLocaleString'][arguments.length=0]",
        "message": "Pass an explicit locale: .toLocaleString('en-US'). With no argument this follows the VIEWER's locale, so the same statement renders as 341,871 / 341 871 / 341.871 depending on who opens it — and a reader whose convention says comma-is-decimal misreads a thousands separator by 1000x. Statements are USD; every viewer must see identical digits. For money prefer formatCurrency() from utils/currencyFormatter."
      },
      {
        "selector": ":matches(CallExpression, OptionalCallExpression)[callee.property.name='toLocaleString'][arguments.0.type='Identifier'][arguments.0.name='undefined']",
        "message": "toLocaleString(undefined, …) still follows the VIEWER's locale — it is the same bug as toLocaleString() with options attached (five of these shipped and showed $9.095.820 to a German browser). Use 'en-US'."
      },
      {
        "selector": "NewExpression[callee.property.name='NumberFormat']:matches([arguments.length=0], [arguments.0.type='Identifier'][arguments.0.name='undefined'])",
        "message": "Intl.NumberFormat without a locale follows the VIEWER's locale. Use new Intl.NumberFormat('en-US', …)."
      },
      {
        "selector": "JSXElement[openingElement.name.name=/^(PieChart|BarChart|LineChart|ScatterChart)$/]:not(:has(Property[key.name='valueFormatter']))",
        "message": "MUI charts format tooltip values with the VIEWER's locale unless the series has a valueFormatter — a Spanish browser showed $998.05 as \"998,045\". Give every series valueFormatter built on formatCurrency()."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/__tests__/**/*.js", "**/*.test.js", "**/*.test.jsx", "src/setupTests.js"],
      "env": { "jest": true }
    }
  ]
}
