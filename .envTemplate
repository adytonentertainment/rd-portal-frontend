REACT_APP_BACKEND_URL='http://localhost:8000'
REACT_APP_FRONTEND_URL='http://localhost:3000'

# Live statements against the API. Required for a production portal.
# REACT_APP_STATEMENTS_LIVE=1

# Production demo only. A production build does not auto-sign-in as the demo
# admin unless this is set. Local development still does, when the live flag is off.
# REACT_APP_DEMO_AUTO_LOGIN=1

# Beta Configuration (optional)
# Comma-separated list of allowed subscription tiers during beta
# REACT_APP_BETA_ALLOWED_TIERS=essential,pro